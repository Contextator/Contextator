# ---- Server ----
PORT=3444
HOST=0.0.0.0
LOG_LEVEL=info
# Public URL used for the MCP URLs shown in the dashboard (defaults to the request host)
PUBLIC_BASE_URL=
# Comma-separated browser origins allowed to call /mcp/* (CLI clients send no Origin and are always allowed)
ALLOWED_ORIGINS=
# Idle MCP *transport* sessions are closed after this many milliseconds. Dashboard sign-ins are
# separate — see AUTH_SESSION_IDLE_MS below.
SESSION_IDLE_TTL_MS=1800000

# ---- Authentication ----
# People sign in to the dashboard with their own account. The first account is created at /setup,
# which asks for a one-time code so that nobody who happens to reach the server before you can
# claim it.
#
# Pick that code here and you never have to go looking for it — the same idea as POSTGRES_PASSWORD
# above. Leave it empty and the server generates one and prints it at every start until the first
# account exists. Either way it stops working the moment that account is created, so there is
# nothing here to rotate later.
#
# It is typed by hand off a screen, so case, dashes and punctuation are ignored when it is checked:
# "ekip-kurulum-2026" and "EKIP KURULUM 2026" are the same code. Give it enough letters and digits
# rather than relying on punctuation.
SETUP_CODE=
#
# ADMIN_TOKEN is machine access to /api/* (Authorization: Bearer ...) and acts with ROOT permissions.
# It is for scripts and CI — treat it like a root password and never paste it into a browser.
ADMIN_TOKEN=
# A dashboard session unused for this long has to sign in again (refreshed while it is in use).
AUTH_SESSION_IDLE_MS=43200000
# Hard ceiling on a session's life, however actively it is used.
AUTH_SESSION_TTL_DAYS=30
# auto = Secure flag when the request arrives over HTTPS. Force with 1; use 0 for a plain-HTTP LAN
# install, or the browser will drop the cookie and the dashboard will loop back to /login.
AUTH_COOKIE_SECURE=auto
# Failed sign-ins per account and per IP before a lockout / 429. The account lockout doubles from
# AUTH_LOGIN_WINDOW_MIN, capped at an hour.
AUTH_LOGIN_MAX_ATTEMPTS=10
AUTH_LOGIN_WINDOW_MIN=15
# Applies to every password, temporary ones included. No composition rules are imposed.
PASSWORD_MIN_LENGTH=12

# ---- MCP OAuth ----
# A CLI client such as Claude Code or Cursor can be configured with a header, so a token you paste
# into it is all it needs. A browser-based connector has nowhere to put one, and asks this server for
# an OAuth flow instead. With this on, it gets one: it discovers where to ask, registers itself,
# sends you to a page here to sign in and approve it, and comes back with a credential that acts as
# YOUR account — so it reads the projects your memberships let you read, and nothing else.
#
# The tokens you mint in the dashboard are unaffected and keep working exactly as they did.
#
# 0 removes the whole OAuth surface: the three discovery documents, the approval page and the token
# endpoint stop existing, and browser connectors cannot connect at all. Static tokens still can.
MCP_OAUTH=1
# How long a credential an approved connector holds is good for, in minutes. It renews itself in the
# background without asking you again. Shorter is not much safer here: your membership is re-checked
# on every single request, so removing somebody's access already takes effect on their next call.
MCP_OAUTH_ACCESS_TTL_MIN=60
# How long an idle connector can be left before it has to be approved again, in days. An active one
# renews on every use and is never this old.
MCP_OAUTH_REFRESH_TTL_DAYS=30
# A ceiling on how many connectors may register themselves here. Registering grants nothing — the
# grant comes from a person approving one — so this is a limit on rows rather than on access.
#
# It is survivable because of the sweep beside it: a connector that registers and never connects is
# dropped within a day, one that did connect gets a month of idleness. Without that, a ceiling reached
# once would lock every honest connector out until it cleared. There is also a per-host limit of sixty
# registrations an hour, which is there to keep ordinary traffic and ordinary mistakes away from the
# ceiling — it is not a defence against anyone determined, because the address it counts comes from a
# header a client can write.
MCP_OAUTH_MAX_CLIENTS=200

# ---- Database ----
# Docker: PostgreSQL runs inside the contextator container; only the password is needed and it is
# applied when the cluster is created on the first start.
POSTGRES_PASSWORD=contextator
# Local development (`npm run dev`): your own PostgreSQL 16 + pgvector, e.g. docker-compose.dev.yml.
# Ignored inside the Docker image (the container always uses its embedded PostgreSQL).
DATABASE_URL=postgres://contextator:contextator@localhost:5432/contextator

# ---- Persistent storage (docker compose only) ----
# Database and downloaded models live in Docker volumes, so `docker compose down`, image rebuilds and
# container deletion never lose data. Rename the volumes here ...
CONTEXTATOR_PGDATA_VOLUME=contextator-pgdata
CONTEXTATOR_MODELS_VOLUME=contextator-models
CONTEXTATOR_DATA_VOLUME=contextator-data
# ... or store the data in host directories instead (absolute paths, e.g. /srv/contextator/pgdata or
# D:/contextator/pgdata). When set, the corresponding volume above is not used.
# Named volumes are the faster choice for the database on Docker Desktop; host directories work too (tested on Windows).
CONTEXTATOR_PGDATA_PATH=
CONTEXTATOR_MODELS_PATH=
CONTEXTATOR_DATA_PATH=

# ---- Documents ----
# Comma-separated absolute directories a project root may live in.
# Inside docker-compose this is /docs. For local dev on Windows e.g. C:\Users\me\docs
ALLOWED_DOC_ROOTS=/docs
# Host directory bind-mounted read-only to /docs in the container (docker-compose only)
DOCS_HOST_PATH=./docs
# Comma-separated globs (posix, relative to the project root) to skip while indexing
IGNORE_GLOBS=**/CHANGELOG.md
# Writable directory for materialised sources: uploaded files, git checkouts, Notion pulls.
# docker-compose mounts a volume at /data; for local dev a relative path is resolved from the working directory.
DATA_DIR=.data
# Encrypts tokens of private git repositories and Notion integrations at rest (AES-256-GCM).
# At least 32 random characters, e.g. `openssl rand -hex 32`. Required only when such a source is added;
# changing it later invalidates stored tokens (re-enter them in the dashboard).
SECRET_KEY=
# How much of each document's text is stored in the database, in bytes of UTF-8.
#
# read_document serves this column rather than reading the file, so a document stays readable after its
# file moves, is renamed, or its git checkout is re-cloned — and an agent can never be served a page
# that was never indexed. What is stored is the *transformed* text, the same string the chunker was
# given, so read_document and search_docs cannot disagree about what an Obsidian or Notion document
# says; the cost is that the original wikilink syntax is not readable through MCP.
#
# Past this cap the prefix is stored and read_document says so. A megabyte of Markdown is a document
# nobody wrote by hand, and PostgreSQL compresses the column out of line, so the steady-state cost is a
# small fraction of what the same document's vectors cost — see OPERATIONS.md §7. Lower it if you index
# a generated corpus of very large files and only ever search it.
MAX_STORED_DOCUMENT_BYTES=1048576

# ---- Uploads ----
# Limits for the dashboard's file/folder/archive uploads (bytes). Archives (zip, tar, tar.gz, rar) are
# extracted on the server; entries escaping the target directory are rejected.
UPLOAD_MAX_FILE_BYTES=52428800
UPLOAD_MAX_FILES_PER_REQUEST=500
UPLOAD_MAX_ARCHIVE_BYTES=268435456
ARCHIVE_MAX_ENTRIES=20000
ARCHIVE_MAX_TOTAL_BYTES=1073741824

# ---- Embeddings ----
# local  = @huggingface/transformers (runs on CPU, no API key)
# openai = OpenAI embeddings API (requires OPENAI_API_KEY)
EMBEDDING_PROVIDER=local
# Local model (384-d). The default is trained for retrieval — a question and the passage that answers
# it — rather than for paraphrase similarity, reads 512 tokens, and covers 100 languages including
# Turkish. fp32, fp16 and q8 artefacts all exist for it (see EMBEDDING_DTYPE below).
# Alternatives, both also 384-d so neither needs RESET_VECTORS:
#   Xenova/paraphrase-multilingual-MiniLM-L12-v2  the previous default; reads only 128 tokens
#   Xenova/all-MiniLM-L6-v2                       English only, smaller and faster
EMBEDDING_MODEL=Xenova/multilingual-e5-small
# Must match the model. 384 for every local model named above, 1536 for text-embedding-3-small.
# Changing this after data exists requires RESET_VECTORS=1 once (drops all chunks).
EMBEDDING_DIMENSIONS=384
# fp32 (default, ~470 MB), fp16 (~235 MB) or q8 (quantized, ~120 MB). All three exist for the models
# named above; a model without the artefact for the dtype you pick fails the download with a 404.
EMBEDDING_DTYPE=fp32
EMBEDDING_BATCH_SIZE=16
# Where downloaded models are cached (docker-compose mounts a volume at /app/.cache/models)
MODEL_CACHE_DIR=.cache/models
# Set to 1 to forbid model downloads (air-gapped hosts with a pre-populated cache)
EMBEDDING_OFFLINE=0
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# How many tokens the model actually reads *usefully* — the window it was trained at, which is not the
# same as the point its tokenizer truncates at. The default model reads all 512 it truncates at, so the
# two agree; Xenova/paraphrase-multilingual-MiniLM-L12-v2 reads 128 and truncates at 512, and a chunk
# between the two is embedded in full by weights that were never trained to represent that much — the
# resulting vector looks exactly as confident as any other.
# Leave it empty and the server works the window out from the model it loaded, then warns after startup
# if CHUNK_MAX_TOKENS does not fit. Set it — for a model this build has never heard of, or one whose
# card says something different — and it overrules that, and a CHUNK_MAX_TOKENS that contradicts it
# refuses to start instead of warning.
EMBEDDING_MAX_INPUT_TOKENS=
# The instruction prefixes an asymmetric model expects in front of a search query and in front of an
# indexed passage. The default model is one: intfloat's multilingual-e5 card says every input must start
# with "query: " or "passage: " because that is how the model was trained. The server knows that, puts
# them on itself, and nothing you index or search has to mention them — these two variables exist for a
# model the server has not heard of, and for turning the defaults off.
#
# Leave them empty and the model decides: "query: " / "passage: " for multilingual-e5-*, nothing at all
# for every other model, in which case a query and a passage are encoded identically and this costs you
# nothing. Setting them replaces one side each.
#
# The trailing space is part of the string and .env strips an unquoted one, so quote the value:
#   EMBEDDING_QUERY_PREFIX="query: "
# An *empty* value means "unset", not "no prefix" — the whole file is written that way. To run the
# default model deliberately without its prefixes, say so:
#   EMBEDDING_QUERY_PREFIX=none
#   EMBEDDING_PASSAGE_PREFIX=none
#
# Either variable changes the model id every project is stamped with, so changing one re-indexes every
# project on its next run — including setting them to `none`, which puts the id back exactly where it was
# before prefixes existed.
EMBEDDING_QUERY_PREFIX=
EMBEDDING_PASSAGE_PREFIX=

# ---- Search ----
# How far into the vector index one search is allowed to look. There is a single HNSW index over every
# project's chunks, and pgvector filters *after* it: the index produces its candidates ordered by
# distance, and only then does "this project, this generation" throw away the ones that do not match.
# So a project that is not near the top of the whole instance's ordering can be answered with too few
# hits — or with none, which looks exactly like a project that has nothing to say.
#
# All three are applied per search and to that search only, so changing them needs a restart and never
# a re-index. On pgvector older than 0.8 the last two do nothing and search behaves as it always did.
#
# Candidates produced before any filtering. pgvector's own default is 40; 100 is the usual setting for
# a corpus this size. It costs latency on every search, including the ones that were already fine.
# The server refuses to start below 50, which is how many candidates the vector half of one search now
# asks for before the keyword half is fused with it — below that the index is short by construction.
HNSW_EF_SEARCH=100
# What to do when the filter leaves fewer hits than were asked for: keep scanning (relaxed_order),
# keep scanning and hold distance order inside PostgreSQL at a higher cost (strict_order), or answer
# short (off — pgvector's default). relaxed_order returns the rows in no particular order and the
# server sorts them by score itself, so what an agent receives is ranked either way.
HNSW_ITERATIVE_SCAN=relaxed_order
# What actually ends an iterative scan: how many index entries one search may visit before it answers
# with what it has. It counts the *whole instance's* entries, not the project's — a project holding one
# per cent of the rows has to be scanned past before it is found — so this is the number to raise when
# a small project still comes back short, and the one to raise as the instance grows rather than as the
# project does. It costs nothing on searches that finish early.
HNSW_MAX_SCAN_TUPLES=20000

# The four below do not change what a search *finds*. They change which of it an agent is handed, and
# each default is the value the retrieval eval was run at.
#
# How many excerpts of one document may appear in one answer. Without a cap, five results are routinely
# five consecutive chunks of the same page — the same answer five times, and four other pages that
# never got a look in. The excerpts a cap displaces are refilled from the ones below them, so an agent
# that asked for five still gets five. It costs nothing measurable: on the eval corpus recall@5 is
# 87.5 % capped against 85.9 % uncapped, because what the cap drops is a near-duplicate of something
# already on the page. Set it to 20 to turn it off.
SEARCH_MAX_PER_DOCUMENT=2
# How many chunks either side of a hit are shown with it, as context around the excerpt rather than as
# further results. One carries the sentence a chunk boundary cut in half and usually saves the agent a
# read_document call. It is not free: a chunk is CHUNK_MAX_TOKENS, so a hit with one neighbour each
# side is about three times the context a hit used to be. 0 turns it off.
SEARCH_NEIGHBOR_CONTEXT=1
# The ceiling on one rendered search_docs answer, in characters, after which it is cut with an explicit
# […truncated] naming how many excerpts were left out. A default answer — five excerpts, one neighbour
# a side — renders at around 3 300 characters, so this is the budget of an agent that asked for twenty.
SEARCH_MAX_RESULT_CHARS=12000
# The similarity below which search_docs answers "no good match, try list_topics or different wording"
# instead of handing over its best hit. 0 turns it off.
#
# **This number is about one embedding model and it was measured against the default one.** Under
# multilingual-e5-small every question the eval corpus answers has a top hit at 0.833 or above, while a
# question about something the corpus has never heard of tops out at 0.829 — so 0.82 sits below
# everything real with a little room, and refuses ten of twelve questions that are not about the
# documentation at all. Not one of the 64 eval questions falls under it.
#
# What it does *not* catch is a question shaped like your product whose answer simply is not written
# down: those score in the same band as questions that are answered, and no threshold separates them.
#
# If you change EMBEDDING_MODEL, this number means something else — another model can score the same
# pair of texts far lower, and then every search answers "no good match". The server says so in a
# startup warning; re-measure it with `npm run eval` or set it to 0.
SEARCH_SCORE_FLOOR=0.82

# A cross-encoder that re-scores the fused candidates before the page is cut, reading the question and
# each passage together. It exists for cross-lingual search — a question in one language about a page
# in the other — and it was built, measured and left off.
#
# **Leave it off.** Measured on the golden set: cross-lingual recall@5 goes 13.3% -> 33.3%, which is
# still below the 40.0% the embedding model *before* this one manages with nothing bolted on; thirteen
# ordinary questions lose their rank-1 answer; and a search goes from 12 ms to 1.2 s on an idle laptop,
# against a sub-second budget, on the CPU the indexing queue already competes for. It also downloads a
# second model — 296 MB at q8 — on first use. `eval/BASELINE.md` has all of it. The README section
# "Cross-lingual search is a known limit" says what to do instead.
#
# It stays in the tree so the measurement can be re-run rather than re-argued.
SEARCH_RERANK=off
# SEARCH_RERANK_MODEL=Xenova/bge-reranker-base
# SEARCH_RERANK_DTYPE=q8
# SEARCH_RERANK_MAX_TOKENS=128
# SEARCH_RERANK_BATCH=16

# ---- Query log ----
# What agents asked, and what they got back: one row per search, with the excerpts it returned, the
# best score, whether the score floor above refused it, and which embedding model answered.
#
# **It is the only instrument that can tell you your documentation does not cover something.** The
# floor above cannot: a question shaped exactly like your product whose answer is simply not written
# down scores in the same band as one that is answered. Forty agents asking it in a week, with the best
# match never rising above 0.84, is visible — and that is this table.
#
# **The query text is stored in the clear, because a hash cannot be read back.** That means: it is user
# content, every viewer of a project can read that project's queries, and it is in every pg_dump. The
# retention below is what keeps it from being a permanent record; the privacy page this instance serves
# at /privacy says all of this in §2, §4 and §7.
#
# 0 turns it off for the whole instance, whatever each project says. There is also a per-project switch
# — a column on the project, so it survives a dump and a restore rather than reverting to whatever the
# new host's environment says.
SEARCH_QUERY_LOG=1

# How long a recorded query is kept, in days. Swept on the same quarter-hourly timer as expired
# sessions. Thirty days is a month of traffic, which is what "this week against last week" needs.
SEARCH_QUERY_LOG_RETENTION_DAYS=30

# ---- Audit log ----
# Who changed this instance, and what they changed. One row per state-changing admin request that
# succeeded — a source deleted, an MCP token minted, a project's access mode switched, a membership
# granted — with the account that did it.
#
# **It is not the query log with a second name.** That one records what agents *asked*: user content,
# kept for thirty days because it is. This records what an operator *did*: no question, no document,
# no excerpt ever reaches a column of it. The two are separate tables under separate windows, and the
# privacy page this instance serves at /privacy depends on them staying separate.
#
# There is no switch. The retention below is the setting; whether a change is recorded at all is not,
# because an instance that could be configured not to record who changed it would have an audit log
# that proves nothing. Writing happens in the policy layer, which is the only place that already knows
# who is asking — so a route added tomorrow is recorded without anybody remembering to record it.
#
# A year, and the reason is the opposite of the query log's: these rows are a few dozen a month, they
# carry nothing anybody typed, and "who deleted that source" is routinely asked about last quarter.
AUDIT_LOG_RETENTION_DAYS=365

# ---- Metrics ----
# Prometheus text at GET /metrics: the indexing queue by lane, the last index run and whether it
# worked, searches by where they came from, the database pool, and whether the database is answering.
#
# **It is not public, and that is a decision rather than a default.** The exposition names this
# instance's version, its embedding model, how many projects are queued and how deep its pool is,
# which is a description of the machine to anyone who can reach the port. So with neither setting
# below, /metrics answers a signed-in account or ADMIN_TOKEN and nobody else.
#
# The scrape credential is what makes that affordable. It reaches /metrics and nothing else, so
# scraping does not mean handing Prometheus an ADMIN_TOKEN that acts with root permissions over every
# project. In prometheus.yml:
#
#   scrape_configs:
#     - job_name: contextator
#       authorization: { credentials: "<the value below>" }
#       static_configs: [{ targets: ["contextator:3444"] }]
#
# At least 16 characters; generate it the way you would any other secret (`openssl rand -hex 32`).
METRICS_TOKEN=

# 1 answers /metrics with no credential at all. For a container on a private network, or an instance
# behind a proxy that already decides who may reach this path — there, a second credential is ceremony
# over a door somebody else is guarding. Anywhere the port is reachable, leave it at 0.
METRICS_PUBLIC=0

# ---- Chunking ----
# Tokens, counted with the embedding model's own tokenizer rather than guessed at from the character
# count. 96 is what measured best on the retrieval eval with the default model — not what fits its
# window, which is 512 and would allow 496. A long passage is embedded as the average of everything in
# it, so filling the window makes each vector vaguer and leaves fewer chunks to match against; on the
# eval corpus 496 scores four points of recall@5 below 96. Raise it on OpenAI, whose window is 8191 —
# 400 or more is reasonable there.
#
# Changing it re-chunks every project on its next index run, so the old chunks stay until you re-index.
CHUNK_MAX_TOKENS=96
# How much of the previous chunk is repeated at the head of the next one. Must be smaller than
# CHUNK_MAX_TOKENS; a quarter of it keeps a whole sentence across a boundary without duplicating half
# the chunk. Scale it with the budget rather than leaving it where a larger budget put it.
CHUNK_OVERLAP_TOKENS=24

# ---- Scheduled sync ----
# The server checks its sources on a timer instead of waiting for somebody to press a button.
#
# **It does not re-scan to decide.** Each source type answers one cheap question — `git ls-remote` for
# the branch head, one Notion `search` for the newest edit, file count and newest mtime for a
# directory — and the index run only happens when that answer moved. Hashing every file to find out
# would have cost most of the run it avoids.
#
# **An upgrade switches nothing on.** Every source that already existed carries "never"; only a source
# created after this release takes the default below. That is what keeps NFR-10's promise — with the
# local embedding provider and no remote sources, this server makes no outbound calls — a property of
# the data rather than of a flag.
#
# The interval a NEWLY created source gets, in minutes. 0 creates every new source unscheduled, which
# is how an instance opts out entirely. Anything else must be between 5 and 43200 (30 days), the band
# the API accepts per source. It never reaches a source that already exists, not even when changed.
SYNC_DEFAULT_INTERVAL_MINUTES=60

# How many due sources one tick — one minute — may probe. The rest keep their turn, oldest first, and
# are taken by the next tick. It bounds the burst a synchronised herd could produce; the random offset
# each source's due time is first written with is what makes the herd unlikely in the first place.
SYNC_PROBES_PER_TICK=10

# The Notion webhook (ADR-0049). A verified subscription turns an edit, a deletion or a move into an
# index run in seconds instead of at the end of the interval - but Notion sends no event for a page
# being *unshared* from the integration, so the interval stays the floor rather than becoming optional.
#
# This is the shortest gap between two webhook-triggered runs of one source. A delivery arriving to a
# source that synced longer ago than this queues a run immediately; one arriving sooner writes the
# earliest permitted moment and lets the scheduler's tick take it, so a script touching two hundred
# pages produces two hundred deliveries and exactly one run. 0 means no minimum at all, which is only
# sane on a small workspace. A single source can override it; leaving its column NULL means this value,
# read live, so changing it here changes every source that names no minimum of its own.
WEBHOOK_MIN_INTERVAL_MINUTES=5
