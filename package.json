{
  "name": "contextator",
  "version": "0.6.0",
  "description": "Multi-tenant MCP documentation server: index Markdown docs into PostgreSQL + pgvector and expose each project as its own MCP endpoint.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "private": false,
  "bin": {
    "contextator": "dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write . && biome check --write .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:integration:report": "npm run test:integration -- --reporter=default --reporter=json --outputFile.json=integration-report.json",
    "test:all": "vitest run",
    "smoke": "tsx scripts/smoke-mcp.ts",
    "build:facts": "tsx scripts/build-product-facts.ts",
    "eval": "tsx scripts/eval.ts",
    "warm-model": "tsx scripts/warm-model.ts",
    "reset-password": "tsx scripts/reset-password.ts",
    "rotate-secret": "tsx scripts/rotate-secret.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^10.1.6",
    "@fastify/static": "^10.1.7",
    "@huggingface/transformers": "^4.3.1",
    "@joplin/turndown-plugin-gfm": "^1.0.68",
    "@modelcontextprotocol/core": "~2.3.1",
    "@modelcontextprotocol/node": "~2.1.1",
    "@modelcontextprotocol/server": "~2.3.1",
    "@modelcontextprotocol/server-legacy": "~2.3.1",
    "@notionhq/client": "^5.27.1",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "isomorphic-git": "^1.44.3",
    "mammoth": "^1.13.0",
    "node-stream-zip": "^1.16.0",
    "node-unrar-js": "^2.0.2",
    "openai": "^7.42.0",
    "openid-client": "^6.8.8",
    "pg": "^8.23.1",
    "picomatch": "^4.0.0",
    "tar": "^7.5.22",
    "tsx": "^4.23.15",
    "turndown": "^7.2.4",
    "unpdf": "^1.9.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@modelcontextprotocol/client": "~2.3.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/picomatch": "^4.0.0",
    "@types/turndown": "^5.0.6",
    "drizzle-kit": "^0.31.11",
    "testcontainers": "^12.1.0",
    "typescript": "~7.0.2",
    "vitest": "^5.0.5"
  },
  "optionalDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "~2.11.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "~2.11.0",
    "@opentelemetry/sdk-trace-base": "~2.11.0"
  }
}
