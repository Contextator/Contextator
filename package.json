{
  "name": "contextator",
  "version": "0.1.0",
  "description": "Multi-tenant MCP documentation server: index Markdown docs into PostgreSQL + pgvector and expose each project as its own MCP endpoint.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write . && biome check --write .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:integration:report": "npm run test:integration -- --reporter=default --reporter=json --outputFile.json=integration-report.json",
    "test:all": "vitest run",
    "smoke": "tsx scripts/smoke-mcp.ts",
    "build:facts": "tsx scripts/build-product-facts.ts",
    "eval": "tsx scripts/eval.ts",
    "warm-model": "tsx scripts/warm-model.ts",
    "reset-password": "tsx scripts/reset-password.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.4",
    "@huggingface/transformers": "^4.3.0",
    "@joplin/turndown-plugin-gfm": "^1.0.68",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@notionhq/client": "^5.26.0",
    "dotenv": "^17.0.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.5",
    "isomorphic-git": "^1.42.2",
    "mammoth": "^1.12.3",
    "node-stream-zip": "^1.16.0",
    "node-unrar-js": "^2.0.2",
    "openai": "^7.17.0",
    "pg": "^8.23.0",
    "picomatch": "^4.0.0",
    "tar": "^7.5.22",
    "tsx": "^4.23.13",
    "turndown": "^7.2.4",
    "unpdf": "^1.8.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/picomatch": "^4.0.0",
    "@types/turndown": "^5.0.6",
    "drizzle-kit": "^0.31.10",
    "testcontainers": "^12.1.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.0"
  }
}
