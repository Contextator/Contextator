{
  "backup": {
    "BACKUP_KEEP": {
      "accepts": ["1", "7", "999999"],
      "default": 7,
      "rejects": ["0", "-1", "1.5", "1000000", "seven"]
    },
    "BACKUP_STAGING_DIR": {
      "default": "DATA_DIR",
      "readBy": "scripts/backup.ts"
    },
    "s3": {
      "defaults": {
        "endpoint": "https://s3.us-east-1.amazonaws.com",
        "prefix": "",
        "region": "us-east-1",
        "sessionToken": null
      },
      "read": [
        "BACKUP_S3_ACCESS_KEY_ID",
        "BACKUP_S3_BUCKET",
        "BACKUP_S3_ENDPOINT",
        "BACKUP_S3_PREFIX",
        "BACKUP_S3_REGION",
        "BACKUP_S3_SECRET_ACCESS_KEY",
        "BACKUP_S3_SESSION_TOKEN"
      ],
      "refusedByVariable": {
        "BACKUP_S3_BUCKET": "BACKUP_S3_BUCKET",
        "BACKUP_S3_ENDPOINT": "BACKUP_S3_ENDPOINT",
        "BACKUP_S3_ENDPOINT_WITH_CREDENTIALS": "BACKUP_S3_ENDPOINT",
        "BACKUP_S3_PREFIX": "BACKUP_S3_PREFIX",
        "BACKUP_S3_REGION": "BACKUP_S3_REGION"
      },
      "required": ["BACKUP_S3_ACCESS_KEY_ID", "BACKUP_S3_BUCKET", "BACKUP_S3_SECRET_ACCESS_KEY"],
      "trimsAndNormalises": {
        "endpoint": "no trailing slash",
        "prefix": "no leading or trailing slash"
      },
      "withEveryVariable": {
        "endpoint": "https://minio.example:9000/base",
        "prefix": "nightly",
        "sessionTokenKept": true
      }
    }
  },
  "cli": {
    "CONTEXTATOR_TOKEN": {
      "appliesTo": "every command except backup",
      "instead": "--token-file",
      "required": true
    },
    "CONTEXTATOR_URL": {
      "appliesTo": "every command except backup",
      "instead": "--url",
      "required": true
    }
  },
  "database": {
    "instead": "DATABASE_URL",
    "libpq": {
      "acceptedAlone": ["PGDATABASE", "PGHOST"],
      "readByNodePostgres": ["PGDATABASE", "PGHOST", "PGPASSWORD", "PGPORT", "PGUSER"]
    }
  },
  "flags": {
    "like EMBEDDING_OFFLINE": {
      "keys": [
        "EMBEDDING_OFFLINE",
        "MCP_OAUTH",
        "MCP_RATE_LIMIT_FAIL_OPEN",
        "MCP_STRUCTURED_OUTPUT",
        "METRICS_PUBLIC",
        "OIDC_AUTO_PROVISION",
        "PII_SCAN",
        "REINDEX_ON_MODEL_CHANGE",
        "RESET_VECTORS",
        "SEARCH_QUERY_LOG",
        "WEB_RESPECT_ROBOTS"
      ],
      "parses": {
        "0": false,
        "1": true,
        "(empty)": false,
        "TRUE": true,
        "True": true,
        "false": false,
        "on": false,
        "true": true,
        "yes": false
      }
    }
  },
